trigger ContactExternalIdTrigger on Contact (after insert, after update) {
    Set<Id> idsToProcess = new Set<Id>();
    for (Contact c : Trigger.new) {
        if (String.isNotBlank(c.idprocontacto__c)) {
            if (Trigger.isInsert || c.idprocontacto__c != Trigger.oldMap.get(c.Id).idprocontacto__c) {
                idsToProcess.add(c.Id);
            }
        }
    }
    if (!idsToProcess.isEmpty()) ContactCalloutProcessor.updateContactEmail(idsToProcess);
}
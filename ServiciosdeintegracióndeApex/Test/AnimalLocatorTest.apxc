@isTest
private class AnimalLocatorTest {
    @isTest 
    static void testGetAnimalNameById() {
        // 1. Asociar el Mock a la prueba
        Test.setMock(HttpCalloutMock.class, new AnimalLocatorMock());
        
        // 2. Llamar al método a probar
        // El ID no importa mucho aquí porque el Mock siempre devolverá "chicken"
        String result = AnimalLocator.getAnimalNameById(1);
        
        // 3. Verificar los resultados
        String expectedValue = 'chicken';
        Assert.areEqual(expectedValue, result, 'El nombre del animal debe ser chicken según el Mock.');
    }
}
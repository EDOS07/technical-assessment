@RestResource(urlMapping='/Accounts/*/contacts')
global with sharing class AccountManager {
    
    @HttpGet
    global static Account getAccount() {
        RestRequest request = RestContext.request;
        // La URL es /Accounts/<Account_ID>/contacts
        // Dividimos la URL para obtener el ID de la cuenta (el penúltimo segmento)
        String requestURI = request.requestURI;
        String accountId = requestURI.substringBetween('/Accounts/', '/contacts');
        
        // Realizamos la consulta de la cuenta con sus contactos relacionados
        Account result = [SELECT Id, Name, (SELECT Id, Name FROM Contacts) 
                        FROM Account 
                        WHERE Id = :accountId 
                        LIMIT 1];
        return result;
    }
}